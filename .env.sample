# ---- Application ----
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Database (PostgreSQL 18 + pgvector) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aeh

# ---- LLM (free-tier, OpenAI-compatible) ----
# Leave the key blank to run with a stub provider (no network calls).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=gpt-oss-120b
LLM_TEMPERATURE=0.2

# ---- Embeddings (local, no API key) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- OCR (local default, vision model optional) ----
# "local" = RapidOCR (printed text); "cloud" = OpenAI-compatible vision model.
# The cloud defaults target a local Ollama server: ollama pull qwen2.5vl:3b
OCR_PROVIDER=local
OCR_VISION_BASE_URL=http://localhost:11434/v1
OCR_VISION_API_KEY=ollama
OCR_VISION_MODEL=qwen2.5vl:3b
# "ollama" uses /api/chat (raises the context window); "openai" uses /chat/completions.
OCR_VISION_API=ollama

# ---- Retrieval / grading ----
TOP_K=5
GRADE_CONCURRENCY=1

# ---- Storage ----
STORAGE_DIR=./storage

# ---- Frontend (Streamlit -> FastAPI) ----
AEH_API_BASE_URL=http://localhost:8000/api/v1
# Long read timeout: paper generation with validation repairs can take minutes.
AEH_REQUEST_TIMEOUT=600
