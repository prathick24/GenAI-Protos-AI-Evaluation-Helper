erDiagram
    USERS ||--o{ EXAMS : creates
    USERS ||--o{ SYLLABUS : creates
    USERS ||--o{ CONVERSATIONS : owns
    CONVERSATIONS ||--o{ CONVERSATION_MESSAGES : contains
    EXAMS }o--|| QUESTION_PAPERS : uses
    QUESTION_PAPERS }o--|| SYLLABUS : sourced_from
    SYLLABUS ||--o{ SYLLABUS_CHUNKS : contains
    SYLLABUS_CHUNKS ||--o{ QUESTIONS : cited_by
    QUESTION_PAPERS ||--o{ QUESTIONS : contains
    QUESTIONS ||--o{ RUBRIC_CRITERIA : graded_by
